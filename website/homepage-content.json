  "transferredSections": {
    "architecture": "<section class=\"block\" id=\"architecture\">\n<h2><span class=\"en\">Architecture</span><span class=\"zh\">架构</span></h2>\n<figure class=\"figure\"><img src=\"/assets/arch.png?v=20261012-guide\" width=\"1800\" height=\"756\" loading=\"lazy\" alt=\"Architecture: VirtuosoClient sends SKILL over TCP to the bridge daemon inside Virtuoso; SSHClient manages tunnels and files; SpectreSimulator runs Spectre separately.\" /></figure>\n<ul class=\"bullets\"><li><span class=\"en\"><strong>VirtuosoClient</strong>: a plain TCP SKILL client. Sends SKILL as JSON and gets results; it knows nothing about SSH.</span><span class=\"zh\"><strong>VirtuosoClient</strong>：纯 TCP 的 SKILL 客户端，以 JSON 发送 SKILL 并取回结果，不关心 SSH。</span></li><li><span class=\"en\"><strong>SpectreSimulator</strong>: runs standalone Spectre locally or over SSH and parses PSF ASCII results into Python data.</span><span class=\"zh\"><strong>SpectreSimulator</strong>：在本机或经 SSH 运行独立 Spectre，把 PSF ASCII 结果解析成 Python 数据。</span></li><li><span class=\"en\"><strong>SSHClient</strong>: resolves the GUI, deployment, daemon and Spectre host roles, keeps a standalone port forward to the daemon host, and runs role-specific commands and transfers over OpenSSH or Paramiko. Skipped in local mode.</span><span class=\"zh\"><strong>SSHClient</strong>：解析 GUI、部署、daemon、Spectre 各主机角色，维持到 daemon 主机的独立端口转发，并通过 OpenSSH 或 Paramiko 执行各角色的命令与文件传输。本机模式下不使用。</span></li></ul>\n<p><span class=\"en\">VirtuosoClient works with any TCP endpoint (SSH tunnel, VPN, LAN or local), and each profile manages its own tunnel to a separate server. To see the raw mechanism, start with <a href=\"https://github.com/Arcadia-1/virtuoso-bridge-lite/blob/main/src/virtuoso_bridge/virtuoso/basic/resources/ramic_bridge.il\">ramic_bridge.il</a> and <a href=\"https://github.com/Arcadia-1/virtuoso-bridge-lite/blob/main/src/virtuoso_bridge/virtuoso/basic/bridge.py\">bridge.py</a>.</span><span class=\"zh\">VirtuosoClient 可连接任何 TCP 端点（SSH 隧道、VPN、局域网或本机），每个配置各自管理到一台服务器的隧道。想看底层机制，从 <a href=\"https://github.com/Arcadia-1/virtuoso-bridge-lite/blob/main/src/virtuoso_bridge/virtuoso/basic/resources/ramic_bridge.il\">ramic_bridge.il</a> 和 <a href=\"https://github.com/Arcadia-1/virtuoso-bridge-lite/blob/main/src/virtuoso_bridge/virtuoso/basic/bridge.py\">bridge.py</a> 读起。</span></p>\n</section>",
    "cite": "<section class=\"block\" id=\"cite\">\n<h2><span class=\"en\">Citation</span><span class=\"zh\">引用</span></h2>\n<p><span class=\"en\">If you use Virtuoso Bridge in academic work, please cite:</span><span class=\"zh\">如果在学术工作中使用了 Virtuoso Bridge，请引用：</span></p>\n<div class=\"code\"><div class=\"code-head\"><span>BibTeX</span><button class=\"copy-button js-only\" type=\"button\" data-copy=\"guide-code-4\"><span class=\"en\">Copy</span><span class=\"zh\">复制</span></button></div><pre id=\"guide-code-4\"><code>@article{zhang2025virtuosobridge,\n  title   = {Virtuoso-Bridge: An Agent-Native Bridge for Remote Analog and Mixed-Signal Design Automation},\n  author  = {Zhang, Zhishuai and Li, Xintian and Sun, Nan and Jie, Lu},\n  year    = {2025}\n}</code></pre></div>\n<p><span class=\"en\">Authors: Zhishuai Zhang, Xintian Li, Nan Sun and Lu Jie, Tsinghua University.</span><span class=\"zh\">作者：Zhishuai Zhang、Xintian Li、Nan Sun、Lu Jie（清华大学）。</span></p>\n</section>"
  },
  "comparison": {
    "rows": [
      {
        "heading": "<span class=\"en\">Where Virtuoso runs</span><span class=\"zh\">Virtuoso 在哪</span>",
        "vb": "<span class=\"en\">This machine, or a remote server over SSH (jump hosts too)</span><span class=\"zh\">本机，或通过 SSH 连接远程服务器（支持跳板机）</span>",
        "sb": "<span class=\"en\">Same machine only: Unix socket or localhost TCP</span><span class=\"zh\">仅限本机：Unix socket 或 localhost TCP</span>"
      },
      {
        "heading": "<span class=\"en\">Schematic, layout, Maestro</span><span class=\"zh\">原理图、版图、Maestro</span>",
        "vb": "<span class=\"en\"><code>create()</code> / <code>modify()</code> editors, CDF parameters with callbacks, Maestro runs and results</span><span class=\"zh\"><code>create()</code> / <code>modify()</code> 编辑接口、带回调的 CDF 参数设置、Maestro 运行与结果读取</span>",
        "sb": "<span class=\"en\">Call the SKILL functions yourself</span><span class=\"zh\">自己调用 SKILL 函数</span>"
      },
      {
        "heading": "Spectre",
        "vb": "<span class=\"en\">Runs netlists locally or over SSH and parses PSF ASCII, no Virtuoso needed</span><span class=\"zh\">本机或经 SSH 跑网表并解析 PSF ASCII，不需要 Virtuoso</span>",
        "sb": "<span class=\"en\">Not included</span><span class=\"zh\">不包含</span>"
