{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtuoso-bridge-site",
  "main": "worker.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [{"pattern": "virtuoso-bridge.tokenzhang.com", "custom_domain": true}],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {"bindings": [{"name": "ANALYTICS", "class_name": "AnalyticsDO"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AnalyticsDO"]}],
  "observability": {"enabled": true}
}
