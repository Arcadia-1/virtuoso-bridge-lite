# virtuoso-bridge configuration
#
# Common setups:
#
#   1. Windows -> local VM (VirtualBox/VMware/WSL):
#      VB_REMOTE_HOST=192.168.x.x     (VM's IP, find with `ip addr` or `ifconfig` inside VM)
#      VB_REMOTE_USER=your_vm_user
#      Verify: ssh your_vm_user@192.168.x.x
#
#   2. Windows -> remote server via jump host:
#      VB_REMOTE_HOST=server-name
#      VB_REMOTE_USER=your_username
#      VB_JUMP_HOST=bastion.example.com
#      Verify: ssh -J your_username@bastion.example.com your_username@server-name
#
#   3. Linux -> local Virtuoso (same machine):
#      VB_REMOTE_HOST=localhost
#      VB_REMOTE_USER=
#

VB_REMOTE_HOST=
VB_REMOTE_USER=

# Local client identity used as a remote scratch path segment.
# Defaults to the local account running bridge (for example Windows USERNAME).
# Set this when multiple local machines share one remote account/scratch root.
# VB_CLIENT_ID=

# Jump host (only if your SSH path uses a bastion)
# VB_JUMP_HOST=
# VB_JUMP_USER=

# Port configuration (auto-assigned, override only if needed)
VB_REMOTE_PORT={remote_port}
VB_LOCAL_PORT={local_port}

# SSH backend for remote commands and file transfer.  The default is OpenSSH.
# Paramiko keeps one authenticated target connection and opens concurrent SSH
# sessions on it.  Install it with: uv pip install -e '.[ssh]'
# VB_SSH_BACKEND=paramiko
# Set this no higher than the target sshd MaxSessions value.  Extra local work
# waits for a session permit instead of opening another SSH connection.
# VB_SSH_MAX_SESSIONS=10
# Paramiko backend only: route the first SSH hop through an unauthenticated
# SOCKS5 proxy.  The proxy resolves the proxied first-hop hostname.
# VB_SSH_PROXY=socks5://127.0.0.1:10800

# OpenSSH backend only: if your SSH build supports ControlMaster multiplexing,
# it is enabled by default. To force it for a nonstandard Windows SSH build:
# VB_FORCE_CONTROL_MASTER=true
# To disable OpenSSH ControlMaster:
# VB_DISABLE_CONTROL_MASTER=true

# Spectre — only needed if `spectre` is NOT already on PATH in the remote shell.
# Option 1: explicit binary path (fastest, most reliable)
# VB_SPECTRE_BIN=/opt/cadence/SPECTRE231/bin/spectre
# Option 2: source a cshrc that adds spectre to PATH
# VB_CADENCE_CSHRC=/path/to/cshrc/that/sets/up/cadence/tools
